diff --git a/app/src/test/java/com/sterownikco/pro/widget/WidgetOutdoorSourceTest.kt b/app/src/test/java/com/sterownikco/pro/widget/WidgetOutdoorSourceTest.kt
new file mode 100644
index 0000000..e86c242
--- /dev/null
+++ b/app/src/test/java/com/sterownikco/pro/widget/WidgetOutdoorSourceTest.kt
@@ -0,0 +1,13 @@
+package com.sterownikco.pro.widget
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class WidgetOutdoorSourceTest {
+    @Test fun outdoorSlotFollowsTheSharedChoice() {
+        assertEquals("t_zewn", WidgetOutdoorSource.key("t_zewn", 1))
+        assertEquals("t_zewn_2", WidgetOutdoorSource.key("t_zewn", 2))
+        assertEquals("t_zewn", WidgetOutdoorSource.key("t_zewn", -1))
+        assertEquals("t_bojler", WidgetOutdoorSource.key("t_bojler", 2))
+    }
+}
diff --git a/app/src/test/java/com/sterownikco/pro/widget/WidgetTemperatureBoundsTest.kt b/app/src/test/java/com/sterownikco/pro/widget/WidgetTemperatureBoundsTest.kt
index 5c03334..edfe8ba 100644
--- a/app/src/test/java/com/sterownikco/pro/widget/WidgetTemperatureBoundsTest.kt
+++ b/app/src/test/java/com/sterownikco/pro/widget/WidgetTemperatureBoundsTest.kt
@@ -30,4 +30,15 @@ class WidgetTemperatureBoundsTest {
         }
         assertNull(WidgetTemperatureBounds.value("unknown", 0.0, false))
     }
+    @Test fun secondOutdoorSensorHasIndependentBounds() {
+        for (simulation in listOf(false, true)) {
+            assertEquals(-25.0, WidgetTemperatureBounds.value("t_zewn_2", -25.0, simulation)!!, 0.0)
+            assertEquals(0.0, WidgetTemperatureBounds.value("t_zewn_2", 0.0, simulation)!!, 0.0)
+            assertEquals(80.0, WidgetTemperatureBounds.value("t_zewn_2", 80.0, simulation)!!, 0.0)
+            assertNull(WidgetTemperatureBounds.value("t_zewn_2", -25.1, simulation))
+            assertNull(WidgetTemperatureBounds.value("t_zewn_2", 80.1, simulation))
+            assertNull(WidgetTemperatureBounds.value("t_zewn_2", null, simulation))
+        }
+    }
+
 }
