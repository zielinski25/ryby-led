--- /dev/null
+++ b/app/src/test/java/com/sterownikco/pro/core/OutdoorDiagnosticTemperatureTest.kt
@@ -0,0 +1,47 @@
+package com.sterownikco.pro.core
+
+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+
+class OutdoorDiagnosticTemperatureTest {
+    @Test fun validValuesIncludingZeroAndNegativeAreIndependent() {
+        val s = PiecState()
+        s.applyIncomingData(JSONObject("""{"t_zewn":12.5,"t_zewn_2":0,"t_zewn_3":-12.3}"""))
+        assertEquals(12.5, s.valOf("zewn", "t_zewn"), 0.0)
+        assertEquals(0.0, s.valOf("zewn_2", "t_zewn_2"), 0.0)
+        assertEquals(-12.3, s.valOf("zewn_3", "t_zewn_3"), 0.0)
+        assertTrue(s.hasData("t_zewn_2"))
+        assertTrue(s.hasData("t_zewn_3"))
+    }
+
+    @Test fun missingNullWrongTypeAndOutOfRangeAreNotZeroOrOldValues() {
+        val s = PiecState()
+        s.applyIncomingData(JSONObject("""{"t_zewn_2":15,"t_zewn_3":16}"""))
+        for (payload in listOf("{}", """{"t_zewn_2":null,"t_zewn_3":null}""", """{"t_zewn_2":"15","t_zewn_3":true}""", """{"t_zewn_2":-40.1,"t_zewn_3":85.1}""")) {
+            s.applyIncomingData(JSONObject(payload))
+            assertFalse(s.hasData("t_zewn_2"))
+            assertFalse(s.hasData("t_zewn_3"))
+            assertTrue(s.t_zewn_2.isNaN())
+            assertTrue(s.t_zewn_3.isNaN())
+        }
+    }
+
+    @Test fun boundariesAndOlderFirmwareAreSupported() {
+        val s = PiecState()
+        s.applyIncomingData(JSONObject("""{"t_zewn_2":-40,"t_zewn_3":85}"""))
+        assertTrue(s.hasAllData("t_zewn_2", "t_zewn_3"))
+        s.applyIncomingData(JSONObject("""{"t_zewn":20}"""))
+        assertTrue(s.hasData("t_zewn"))
+        assertFalse(s.hasData("t_zewn_2"))
+        assertFalse(s.hasData("t_zewn_3"))
+    }
+
+    @Test fun dashboardHasDistinctDefaultTiles() {
+        val tiles = TileDefs.TILES.associateBy { it.id }
+        assertEquals("Zew 1", tiles.getValue("zewn").title)
+        assertEquals("Zew 2", tiles.getValue("zewn_2").title)
+        assertEquals("Zew 3", tiles.getValue("zewn_3").title)
+        assertTrue(TileDefs.DEFAULT_VISIBLE_IDS.containsAll(listOf("zewn_2", "zewn_3")))
+    }
+}
