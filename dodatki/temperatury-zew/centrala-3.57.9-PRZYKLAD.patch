 static const uint32_t WDT_TIMEOUT_MS = 15000UL;
 
+// Dodatkowe odczyty tylko diagnostyczne; atomowy snapshot między taskami.
+static portMUX_TYPE g_tempDiagMux = portMUX_INITIALIZER_UNLOCKED;
+static float g_tempDhtDiag = NAN, g_tempBmpDiag = NAN;
+static uint32_t g_tempDhtAt = 0, g_tempBmpAt = 0;
+static bool g_bmpDiagGotowy = false;
+static void zapiszTempDiag(bool dht, float v) {
+  portENTER_CRITICAL(&g_tempDiagMux);
+  if (dht) { g_tempDhtDiag = v; g_tempDhtAt = millis(); }
+  else { g_tempBmpDiag = v; g_tempBmpAt = millis(); }
+  portEXIT_CRITICAL(&g_tempDiagMux);
+}
+static String jsonTempDiag(bool dht) {
+  float v; uint32_t at;
+  portENTER_CRITICAL(&g_tempDiagMux);
+  if (dht) { v = g_tempDhtDiag; at = g_tempDhtAt; }
+  else { v = g_tempBmpDiag; at = g_tempBmpAt; }
+  portEXIT_CRITICAL(&g_tempDiagMux);
+  return isfinite(v) && (uint32_t)(millis() - at) <= 15000UL ? String(v, 1) : String("null");
+}
