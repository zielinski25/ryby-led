+// Dodatkowe odczyty tylko diagnostyczne; atomowy snapshot między taskami.
+static portMUX_TYPE g_tempDiagMux = portMUX_INITIALIZER_UNLOCKED;
+static float g_tempDhtDiag = NAN, g_tempBmpDiag = NAN;
+static uint64_t g_tempDhtAtUs = 0, g_tempBmpAtUs = 0;
+static bool g_bmpDiagGotowy = false;
+static void zapiszTempDiag(bool dht, float v) {
+  const uint64_t at = (uint64_t)esp_timer_get_time();
+  portENTER_CRITICAL(&g_tempDiagMux);
+  if (dht) { g_tempDhtDiag = v; g_tempDhtAtUs = at; }
+  else { g_tempBmpDiag = v; g_tempBmpAtUs = at; }
+  portEXIT_CRITICAL(&g_tempDiagMux);
+}
+static float czytajTempDiag(bool dht) {
+  float v; uint64_t at;
+  portENTER_CRITICAL(&g_tempDiagMux);
+  if (dht) { v = g_tempDhtDiag; at = g_tempDhtAtUs; }
+  else { v = g_tempBmpDiag; at = g_tempBmpAtUs; }
+  portEXIT_CRITICAL(&g_tempDiagMux);
+  const uint64_t now = (uint64_t)esp_timer_get_time();
+  return isfinite(v) && now >= at && now - at <= 15000000ULL ? v : NAN;
+}
+static String jsonTempDiag(bool dht) {
+  const float v = czytajTempDiag(dht);
+  return isfinite(v) ? String(v, 1) : String("null");
+}
